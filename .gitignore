# ==========================================
# SECRECY-MAPPER DATA PROTECTION
# ==========================================

# Potentially sensitive source data
/data/raw/**
!/data/raw/.gitkeep

# Derived local data
/data/processed/**
!/data/processed/.gitkeep

# Local/generated data
/data/generated/**
!/data/generated/.gitkeep

# Synthetic data is intentionally tracked.
# Do not add /data/synthetic/ here.

# ==========================================
# GENERATED EVIDENCE AND EXPORTS
# ==========================================

# Ignore disposable generated evidence
/evidence/generated/**
!/evidence/generated/.gitkeep

# Ignore generated charts and exports
*.png
*.jpg
*.jpeg
*.parquet

# ==========================================
# LOGS
# ==========================================

*.log

# Preserve only deliberately tracked evidence logs
!/evidence/**/*.log

